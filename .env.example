# legoin-api configuration. Every variable is optional; these are the defaults.
# The service reads environment variables only: export them, or pass them to your process manager.

# `models` runs the legoin-ml release; `stub` gives made-up detections for tests and frontend work.
LEGOIN_PIPELINE=stub

# The database, photos and downloaded models. Keep it on a persistent disk.
LEGOIN_DATA_DIR=./data

# The legoin-ml release the models come from, and where its files are cached (default: <data dir>/models).
LEGOIN_MODEL_TAG=v0.2.0
LEGOIN_MODEL_DIR=

# Threads torch may use (default: one per core).
LEGOIN_TORCH_THREADS=

# Origins allowed to call the API from a browser, comma-separated.
LEGOIN_CORS_ORIGINS=http://localhost:3000,https://legoin-web.vercel.app

# The public base URL for photo and preview URLs, e.g. https://api.example.com (default: each request's own URL).
LEGOIN_PUBLIC_URL=

# The library of checked builds: its manifest, previews and models (ADR-0010).
LEGOIN_BUILDS_DIR=./builds

# Deadlines and scan concurrency.
LEGOIN_SCAN_TIMEOUT_S=30
LEGOIN_SCAN_WORKERS=1
LEGOIN_SCAN_QUEUE_SIZE=8
LEGOIN_IDEAS_TIMEOUT_S=30

# Ideas from Claude. The key stays empty here: pass the real one with --env-file from a file outside the repo.
ANTHROPIC_API_KEY=
# `anthropic` or `templates` (default: anthropic when ANTHROPIC_API_KEY is set).
LEGOIN_IDEAS_GENERATOR=
LEGOIN_IDEAS_MODEL=claude-sonnet-5-5
LEGOIN_IDEAS_EFFORT=low

# Picture builds (ADR-0012): off unless `anthropic`, the key above, the `picture` extra and the LDraw parts library.
LEGOIN_PICTURE_BUILDS=off
LEGOIN_PICTURE_MODEL=claude-opus-5-5
LEGOIN_PICTURE_EFFORT=medium
# Dollars a day for all picture jobs, jobs per account a day, and each job's dollars, seconds and calls.
LEGOIN_PICTURE_DAILY_BUDGET_USD=3.00
LEGOIN_PICTURE_DAILY_LIMIT=2
LEGOIN_PICTURE_JOB_COST_USD=0.50
LEGOIN_PICTURE_JOB_SECONDS=300
LEGOIN_PICTURE_JOB_CALLS=24
LEGOIN_PICTURE_QUEUE_SIZE=3
LEGOIN_PICTURE_WORKER_MEMORY_MB=1024
# The LDraw parts library, unzipped outside the repository (https://library.ldraw.org/library/updates/complete.zip).
LDRAW_LIBRARY_PATH=

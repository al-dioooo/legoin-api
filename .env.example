# legoin-api configuration. Every variable is optional; these are the defaults.
# The service reads environment variables only: export them, or pass them to your process manager.

# `models` runs the legoin-ml release; `stub` gives made-up detections for tests and frontend work.
LEGOIN_PIPELINE=stub

# The database, photos and downloaded models. Keep it on a persistent disk.
LEGOIN_DATA_DIR=./data

# The legoin-ml release the models come from, and where its files are cached (default: <data dir>/models).
LEGOIN_MODEL_TAG=v0.2.0
LEGOIN_MODEL_DIR=

# Threads torch may use (default: one per core).
LEGOIN_TORCH_THREADS=

# Origins allowed to call the API from a browser, comma-separated.
LEGOIN_CORS_ORIGINS=http://localhost:3000,https://legoin-web.vercel.app

# The public base URL for photo URLs, e.g. https://api.example.com (default: each request's own URL).
LEGOIN_PUBLIC_URL=

# Deadlines and scan concurrency.
LEGOIN_SCAN_TIMEOUT_S=30
LEGOIN_SCAN_WORKERS=1
LEGOIN_SCAN_QUEUE_SIZE=8
LEGOIN_IDEAS_TIMEOUT_S=30
